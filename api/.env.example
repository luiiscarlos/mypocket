SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Shared with client/ (BFF). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_SECRET=
# Only needed for deleteMyAccount. Never expose it outside the API.
SUPABASE_SECRET_KEY=
# UUID of the owner (profiles.account_type = 'real'). Leave empty in dev.
OWNER_USER_ID=
# Comma-separated; empty = no CORS (only the BFF calls the API).
CORS_ORIGINS=
