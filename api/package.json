{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.dev src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "smoke": "tsx --env-file=.env.dev scripts/smoke.ts",
    "seed": "tsx --env-file=.env.dev scripts/seed.ts",
    "seed:prod": "tsx --env-file=.env.prod scripts/seed.ts"
  },
  "dependencies": {
    "@escape.tech/graphql-armor": "3.2.0",
    "@graphql-yoga/plugin-disable-introspection": "2.25.1",
    "@supabase/supabase-js": "2.116.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
